# Copie para .env e preencha. Lido só pelo servidor (src/api/infinitepay.ts), nunca vai para o navegador.
# InfiniteTag da conta, sem o "$"
INFINITEPAY_HANDLE=guilherme-as
# Supabase > Project Settings > API > service_role (ignora o RLS: não compartilhe)
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do site, sem barra no fim. Com túnel (ngrok), use o endereço do túnel.
SITE_URL=http://localhost:4200
