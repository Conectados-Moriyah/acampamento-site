# Segredos das Edge Functions de pagamento (supabase/functions). NUNCA coloque os valores no git.
#
# Produção: cadastre no Supabase (Edge Functions > Secrets) ou pela CLI:
#   npx supabase secrets set --env-file supabase/functions/.env
# Teste local (npx supabase functions serve): copie este arquivo para supabase/functions/.env.

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys, começa com sb_secret_).
# Ignora o RLS: não compartilhe.
SB_SECRET_KEY=
# InfiniteTag da conta, sem o "$"
INFINITEPAY_HANDLE=
# Endereço público do site, sem barra no fim (é para onde a InfinitePay volta depois de pagar)
SITE_URL=https://conectados-moriyah.github.io/acampamento-site
