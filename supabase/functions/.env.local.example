# Segredos das Edge Functions no teste LOCAL (npx supabase start + functions serve).
# Copie para supabase/functions/.env.local e preencha SB_SECRET_KEY com a "Secret key" que o
# `npx supabase status` mostra (é a chave do banco local, não a de produção).
SB_SECRET_KEY=
INFINITEPAY_HANDLE=teste
SITE_URL=http://localhost:4200
# Não chama a InfinitePay: o checkout volta direto para /inscricao/pago como pago (Pix).
INFINITEPAY_SIMULADO=1
